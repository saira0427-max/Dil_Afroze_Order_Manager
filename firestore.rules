rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules → Publish.
// Anyone signed in (i.e. anyone who entered the correct shop PIN) can read
// and write all order/product data. There is only ever one shared account,
// so this is equivalent to "PIN-protected, otherwise fully open."
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
